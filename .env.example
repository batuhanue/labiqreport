# Vercel → Storage → Neon (Postgres) bağlandığında otomatik eklenir
DATABASE_URL=
# İsteğe bağlı: uygulamaya giriş şifresi (boşsa şifresiz açılır)
APP_PASSWORD=
# Push bildirimleri: `npm run vapid` ile üret
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:btubasar@gmail.com
# Vercel Cron isteğini doğrulamak için rastgele uzun bir değer
CRON_SECRET=
# Yapay zekâ asistanı: Anthropic Claude (console.anthropic.com → Settings → API keys)
ANTHROPIC_API_KEY=
# İsteğe bağlı: model (varsayılan claude-haiku-5-5; ör. claude-sonnet-5-5, claude-opus-5-5)
ANTHROPIC_MODEL=claude-haiku-5-5
# Google Workspace (Cloud Console → Credentials → OAuth client ID, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# İsteğe bağlı: varsayılan https://<alan-adı>/api/google/callback
GOOGLE_REDIRECT_URI=
